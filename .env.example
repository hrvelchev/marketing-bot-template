# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to git.
# ============================================================

# ---- Anthropic (required) --------------------------------------------------
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ---- Telegram (required) ---------------------------------------------------
# OPERATOR bot — the one you DM with commands. DM @BotFather, /newbot.
TELEGRAM_BOT_TOKEN_OPERATOR=123456:ABC...

# CHANNEL bot — sender-only, publishes to your public channel. Different bot
# from the operator. Also created via @BotFather. Must be admin in the channel.
TELEGRAM_BOT_TOKEN_CHANNEL=

# Your public channel handle (must include the @). Leave empty to disable.
CHANNEL_HANDLE=@YourChannel

# ---- X / Twitter (optional) ------------------------------------------------
# developer.x.com → create app → enable Read+Write permissions → keys & tokens.
# Pay-per-use as of 2025+; top up credits at console.x.com → Billing → Credits.
# Leave empty to skip X.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Your X username (for building post URLs). No @, e.g. "MyBrand".
X_HANDLE=

# ---- Instagram (optional) --------------------------------------------------
# developers.facebook.com → Meta Developer App → Instagram Graph API product.
# IG account must be Business type, linked to a Facebook Page.
# Leave empty to skip IG.
IG_ACCESS_TOKEN=
# The 17- or 18-digit IG User ID (from `GET /me` on the new Instagram API).
IG_BUSINESS_ACCOUNT_ID=
# Public HTTPS URL where this app serves IG card images so Meta can fetch
# them. Tailscale Funnel, DuckDNS + Caddy, or any reverse-proxied domain.
# Must be reachable from Meta's servers (NOT localhost).
IG_PUBLIC_BASE_URL=https://your-public-host.example.com

# Folder for IG reference templates (PNGs the operator pastes into ChatGPT).
IG_TEMPLATES_DIR=./assets/ig_templates
# Folder where uploaded IG images are saved while awaiting post approval.
IG_UPLOADS_DIR=./data/ig_uploads

# Five hashtags appended to every IG post + the last X tweet.
# Space-separated, with the # signs. Whatever fits your brand.
IG_HASHTAGS=#YourBrand #YourNiche #Tag3 #Tag4 #Tag5

# ---- Voice anchor (recommended) --------------------------------------------
# Markdown file with your brand's voice rules, off-limits topics, FAQ, etc.
# Read into every draft-generation prompt so Claude stays on-brand.
STRATEGY_NOTES_PATH=./strategy_notes.md

# ---- Storage / logging -----------------------------------------------------
DATABASE_PATH=./data/bot.db
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
